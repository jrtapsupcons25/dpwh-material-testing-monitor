# DPWH Material Testing System - Environment Variables
# Copy this file to .env.local and update with your actual values
# DO NOT COMMIT .env.local to Git!

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Get these from your Supabase project dashboard
# https://app.supabase.com → Project Settings → API

REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# ADMIN CREDENTIALS (For initial setup only)
# ============================================================
# These should be changed after first deployment
# Update directly in database in production

REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=change-this-password

# ============================================================
# APP CONFIGURATION
# ============================================================

REACT_APP_ENV=development
REACT_APP_DEBUG=false

# Data refresh interval in milliseconds (default: 5000 = 5 seconds)
REACT_APP_REFRESH_INTERVAL=5000

# ============================================================
# DEPLOYMENT CONFIGURATION
# ============================================================
# For Vercel deployment

VERCEL_ENV=development
NODE_ENV=development

# ============================================================
# SECURITY (For future use)
# ============================================================
# API rate limiting threshold
# REACT_APP_RATE_LIMIT=100

# Session timeout in minutes
# REACT_APP_SESSION_TIMEOUT=30

# ============================================================
# LOGGING & MONITORING
# ============================================================
# Enable console logging for debugging
REACT_APP_ENABLE_LOGGING=true

# Sentry error tracking (optional)
# REACT_APP_SENTRY_DSN=https://your-sentry-url

# ============================================================
# NOTES
# ============================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Update values with your actual configuration
# 3. NEVER commit .env.local to Git
# 4. .gitignore should exclude .env.local
# 5. For production, use Vercel Environment Variables
#    https://vercel.com/docs/concepts/projects/environment-variables
